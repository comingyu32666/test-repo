# ===== 查岗系统环境变量示例 =====
# 复制为 .env 并填入你自己的值，绝不要提交真实密钥

# GitHub（用于自动更新脚本）
GITHUB_TOKEN=你的GitHubToken
REPO_PATH=comingyu32666/test-repo

# ===== Railway 后端 =====
AUTH_TOKEN=你的AUTH_TOKEN

# ===== MCP 代理层（Vercel） =====
# 指向 Railway 后端根域名，形如 https://xxx.up.railway.app
ORIGIN_API=你的Railway域名

# ===== 推送服务（Bark / 全能推送 / 自建） =====
# 自建推送服务或使用其他兼容服务时，把这里改成对应地址即可
BARK_BASE_URL=https://api.day.app
BARK_API_KEY=你的BARK_API_KEY
